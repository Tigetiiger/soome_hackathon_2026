# europress.acq.ee → Node dashboard on 127.0.0.1:8080. Automatic HTTPS (Let's Encrypt).
europress.acq.ee {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy 127.0.0.1:8080 {
		flush_interval -1
	}
	log {
		output file /home/hackathon/final_codebase/dashboard/logs/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
